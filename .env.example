# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env lên Git.

PORT=3000
# Chỉ nhận: development | test | production (giá trị khác → server không khởi động)
NODE_ENV=development
# Địa chỉ public của website (dùng làm return_url cho PayPal). Khác localhost => bắt buộc SESSION_SECRET,
# PayPal mô phỏng tự TẮT, cookie "secure" khi là https.
BASE_URL=http://localhost:3000
# Đặt 1 nếu chạy sau reverse proxy (Nginx…) mà không phải production
TRUST_PROXY=

# MongoDB local hoặc MongoDB Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/cnow

# Chuỗi ngẫu nhiên dài để ký cookie phiên. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Khóa mã hóa bí mật 2FA (TOTP) trong CSDL. Để trống => suy ra từ SESSION_SECRET
# (khi đó đổi SESSION_SECRET thì mọi người phải thiết lập lại 2FA). Nên đặt riêng ở production.
MFA_KEY=
# Mã quản trị (bước xác thực thứ 2 bắt buộc của admin) KHÔNG đặt ở đây: chạy "npm run set:admin-pin" (chỉ lưu hash trong CSDL).

# Giới hạn chung số yêu cầu/phút/IP cho trang động (mặc định 600)
GLOBAL_RATE_LIMIT=

# Cổng thanh toán: demo (MẶC ĐỊNH – PayPal/VNPay/MoMo MÔ PHỎNG, không trừ tiền thật, chạy được cả production,
# không cần biến PAYPAL_*) | paypal (PayPal thật, cần 3 biến PAYPAL_* bên dưới)
PAYMENT_MODE=demo
# Tỉ giá DEMO (VND cho 1 USD) để hiển thị giá VND và tính tiền cổng VNPay/MoMo mô phỏng
DEMO_USD_VND=26000

# PayPal REST API – CHỈ dùng khi PAYMENT_MODE=paypal. Lấy tại https://developer.paypal.com (Apps & Credentials).
# PAYMENT_MODE=paypal ở production bắt buộc khai báo rõ PAYPAL_MODE=live (hoặc sandbox).
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Tài khoản quản trị tạo bởi "npm run seed" / "npm run setup:prod": mật khẩu BẮT BUỘC khi chưa có admin
# (mật khẩu mạnh; script không in mật khẩu ra màn hình). Sau đó chạy "npm run set:admin-pin".
SEED_ADMIN_EMAIL=admin@cnow.local
SEED_ADMIN_PASSWORD=
# Mật khẩu CTV mẫu "congtacvien" (trống => ngẫu nhiên, không in ra)
SEED_COLLAB_PASSWORD=

# Bản demo công khai: true => meta robots noindex + X-Robots-Tag + robots.txt chặn toàn bộ
DEMO_NOINDEX=

# Liên hệ báo lỗ hổng bảo mật trong /.well-known/security.txt (mailto:… hoặc https://…)
SECURITY_CONTACT=
