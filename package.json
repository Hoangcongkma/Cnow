{
  "name": "cnow",
  "version": "1.0.0",
  "private": true,
  "description": "Cnow – website học lập trình trực tuyến (Node.js · Express · MongoDB), thanh toán mô phỏng PayPal/VNPay/MoMo",
  "author": "Hoàng Mạnh Công",
  "license": "MIT",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "setup:prod": "npm run seed && npm run import:content",
    "seed:demo": "node scripts/seed-demo.js",
    "unseed:demo": "node scripts/seed-demo.js --unseed",
    "backup": "node scripts/backup.js",
    "vendor:sync": "node scripts/vendor-sync.js",
    "restore": "node scripts/restore.js",
    "migrate": "node src/migrations.js",
    "import:videos": "node scripts/import-videos.js",
    "video-courses": "node scripts/video-courses.js",
    "set:admin-pin": "node scripts/set-admin-pin.js",
    "import:quiz": "node scripts/import-quiz.js",
    "check:content": "node scripts/check-content.js",
    "import:content": "node scripts/import-content.js",
    "test": "node --test --test-reporter=spec",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-lines=80 --test-reporter=spec --test-reporter-destination=stdout",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "lint:secrets": "secretlint \"**/*\"",
    "prepare": "node .husky/install.mjs",
    "format": "prettier --write . && eslint --fix ."
  },
  "lint-staged": {
    "*.{js,json,md,yml,yaml,css,ejs,txt}": "secretlint",
    "*.js": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --check"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.1",
    "mongoose": "^9.13.0",
    "multer": "^2.5.0",
    "otplib": "^13.6.0",
    "path-to-regexp": "^9.0.0",
    "pdfkit": "^0.21.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "chart.js": "^4.6.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "htmlparser2": "^12.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "mongodb-memory-server": "^11.4.0",
    "php-parser": "^3.7.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "secretlint": "^14.1.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  }
}
