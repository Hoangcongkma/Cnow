{
  "name": "cnow",
  "version": "1.0.0",
  "private": true,
  "description": "Cnow – website học lập trình trực tuyến (Node.js · Express · MongoDB), thanh toán mô phỏng PayPal/VNPay/MoMo",
  "author": "Hoàng Mạnh Công",
  "license": "MIT",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "setup:prod": "npm run seed && npm run import:content",
    "seed:demo": "node scripts/seed-demo.js",
    "unseed:demo": "node scripts/seed-demo.js --unseed",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "migrate": "node src/migrations.js",
    "import:videos": "node scripts/import-videos.js",
    "video-courses": "node scripts/video-courses.js",
    "set:admin-pin": "node scripts/set-admin-pin.js",
    "import:quiz": "node scripts/import-quiz.js",
    "check:content": "node scripts/check-content.js",
    "import:content": "node scripts/import-content.js",
    "test": "node --test --test-reporter=spec",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.6.1",
    "compression": "^1.8.2",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.1",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "otplib": "^13.6.0",
    "path-to-regexp": "^8.4.2",
    "pdfkit": "^0.21.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "mongodb-memory-server": "^11.4.0",
    "php-parser": "^3.7.0",
    "prettier": "^3.10.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  }
}
