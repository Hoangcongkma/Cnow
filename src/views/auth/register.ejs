<%- include('../partials/header') %>
<section class="auth">
  <form class="auth-card" method="post" action="/register" novalidate>
    <h1>Đăng ký thành viên</h1>
    <% if (errors.length) { %><div class="flash flash-error" role="alert"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Họ và tên<input name="name" value="<%= form.name || '' %>" required maxlength="80" autocomplete="name" placeholder="Nhập họ và tên"></label>
    <label>Tên đăng nhập<input name="username" value="<%= form.username || '' %>" required maxlength="30" autocomplete="username" placeholder="vd: hoangcong"></label>
    <label>Email<input type="email" name="email" value="<%= form.email || '' %>" required maxlength="120" autocomplete="email" placeholder="Nhập email"></label>
    <label>Mật khẩu<span class="pw"><input type="password" name="password" required minlength="8" maxlength="72" autocomplete="new-password" placeholder="Ít nhất 8 ký tự, gồm chữ và số"><button type="button" class="pw-toggle" aria-label="Hiện mật khẩu">👁</button></span></label>
    <label>Nhập lại mật khẩu<input type="password" name="confirm" required maxlength="72" autocomplete="new-password" placeholder="Nhập lại mật khẩu"></label>
    <button class="btn btn-block">Đăng ký tài khoản</button>
    <p class="center small muted">Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
  </form>
</section>
<%- include('../partials/footer') %>
